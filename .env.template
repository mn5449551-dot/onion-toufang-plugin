# Onion Ad Skills 配置模板
# Mac / Windows 都由 onion-help 的一键配置复制到用户目录：
# python3 skills/onion-help/scripts/setup_wizard.py ensure
# Mac/Linux: ~/.onion-ad/.env；Windows: %USERPROFILE%\.onion-ad\.env

# ===== KIE API（GPT Image 2，默认 2K）=====
KIE_API_KEY=你的KIE密钥
KIE_BASE_URL=https://api.kie.ai
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
# KIE 未公开生图任务并发额度，默认使用保守的本机并发；可按账号额度自行调高。
ONION_IMAGE_CONCURRENCY=3
ONION_IMAGE_FALLBACK_CONCURRENCY=1

# ===== 插件更新检查 =====
# 默认由 setup_wizard.py ensure/check 使用 24 小时缓存检查 GitHub，且只在 Git 工作区干净并可 fast-forward 时自动更新。
# 如需关闭自动更新检查，取消下一行注释。
# ONION_PLUGIN_AUTO_UPDATE=0

